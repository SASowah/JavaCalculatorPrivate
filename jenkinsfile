pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'samsow/java-calculator-app'
        DOCKER_CREDENTIALS_ID = 'docker-hub-creds' // Must match Jenkins credential ID
    }

    stages {
        // Stage 1: Clone Repository
        stage('Clone Code') {
            steps {
                git branch: 'dev',
                     url: 'https://github.com/SASowah/JavaCalculatorPrivate.git'
            }
        }

        // Stage 2: Build Java Application
        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        // Stage 3: Build Docker Image
        stage('Docker Build') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        // Stage 4: Push to Docker Hub
        stage('Docker Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIALS_ID) {
                        // Use Docker Pipeline methods (not shell commands)
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push()
                        docker.image("${DOCKER_IMAGE}:latest").push()
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "Pipeline succeeded! Image available at: ${DOCKER_IMAGE}"
        }
        failure {
            echo "Pipeline failed! Check logs for errors."
            mail to: 'team@example.com',
                 subject: "Pipeline Failed: ${currentBuild.fullDisplayName}",
                 body: "Check build ${env.BUILD_URL}"
        }
    }
}